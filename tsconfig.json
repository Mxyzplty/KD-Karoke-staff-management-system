{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "esModuleInterop": true, "resolveJsonModule": true,
    "skipLibCheck": true, "lib": ["ES2022", "DOM", "DOM.Iterable"], "types": ["node", "vite/client"]
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "parity/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts", "*.ts"]
}
